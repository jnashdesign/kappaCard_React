rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function underSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function userData(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)).data;
    }

    /** Missing fieldPrivacy / field → public (product default). */
    function fieldIsPublic(userId, field) {
      let data = userData(userId);
      let privacy = data.get('fieldPrivacy', {});
      return privacy.get(field, 'public') != 'private';
    }

    function isProfileImageName(fileName) {
      return fileName.matches('profile[.].+');
    }

    function isContactImageName(fileName) {
      return fileName.matches('contact[.].+');
    }

    function isBackgroundImageName(fileName) {
      return fileName.matches('background[.].+');
    }

    match /profile-pictures/{userId}/{fileName} {
      allow read: if isOwner(userId)
        || (isProfileImageName(fileName) && fieldIsPublic(userId, 'profilePicture'))
        || (isContactImageName(fileName) && fieldIsPublic(userId, 'profilePicture'))
        || (isBackgroundImageName(fileName) && fieldIsPublic(userId, 'cardBackground'));
      allow write: if isOwner(userId) && isImage() && underSizeLimit();
      allow delete: if isOwner(userId);
    }
  }
}
