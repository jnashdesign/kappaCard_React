rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function notChangingPrivileges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'admin',
          'tier',
          'inauguralMember',
          'inauguralSlot',
          'foundingMember',
          'foundingSlot',
          'excludeFromInaugural',
        ]);
    }

    // Anonymous/public viewers may bump engagement counters on a profile.
    function publicEngagementOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stats', 'firstCardViewedAt', 'firstContactDownloadedAt', 'updatedAt']);
    }

    match /users/{userId} {
      // Public card pages need to read profiles without login
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && notChangingPrivileges())
        || isAdmin()
        || publicEngagementOnly();
      allow delete: if isOwner(userId) || isAdmin();

      // Brothers whose cards this member met via QR or saved to Contacts
      match /collectedCards/{cardId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /invites/{inviteId} {
      allow read: if true;
      // Only admins may create invites that grant complimentary Basic.
      allow create: if signedIn()
        && request.resource.data.inviterId == request.auth.uid
        && (
          !('grantsBasic' in request.resource.data)
          || request.resource.data.grantsBasic == false
          || isAdmin()
        );
      allow update: if signedIn() && (
        isAdmin()
        || (
          // Owner: enable/disable (cannot change grantsBasic / identity fields)
          resource.data.inviterId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['grantsBasic', 'inviterId', 'code', 'multiUse'])
        )
        || (
          // Redeemer: mark used / increment share usage (cannot flip grantsBasic)
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'grantsBasic',
              'inviterId',
              'inviterName',
              'inviterUsername',
              'inviterChapter',
              'inviterInitiationYear',
              'code',
              'multiUse',
              'createdAt'
            ])
        )
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.inviterId == request.auth.uid);
    }

    match /inviteRequests/{requestId} {
      // Anyone can request an invite (no account yet)
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'name', 'chapter', 'initiationYear', 'email', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.chapter is string
        && request.resource.data.chapter.size() >= 2
        && request.resource.data.chapter.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.initiationYear is int
        && request.resource.data.initiationYear >= 1911
        && request.resource.data.initiationYear <= 2100
        && request.resource.data.createdAt is string;
      allow read, update, delete: if isAdmin();
    }

    // Written by the member at delete-time; admins read for churn analytics.
    match /accountDeletions/{deletionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'username', 'email', 'name', 'chapter', 'province',
          'initiationYear', 'tier', 'wasActivated', 'deletedAt', 'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.deletedAt is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Written only by Admin SDK (Stripe webhook). Clients cannot read/write.
    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // Launch promo counter (founding 100). Public read for countdown; Admin SDK writes.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * Encounters: QR (or future explicit) meetings between a scanner and a card owner.
     * Distinct from users.stats.cardViews* analytics.
     *
     * Privacy:
     * - Anonymous rows have anonymousSessionId only (no PII); owners cannot read them.
     * - Identified rows are readable by the scanner (viewerId). Owners do not get client
     *   read access in v1 so privateNote cannot leak via full-document reads.
     * - Claim attaches viewerId on login using the local anonymous session id.
     */
    match /encounters/{encounterId} {
      function encounterKeysOk() {
        return request.resource.data.keys().hasOnly([
          'ownerId',
          'viewerId',
          'anonymousSessionId',
          'timestamp',
          'source',
          'event',
          'location',
          'privateNote',
          'createdAt',
          'updatedAt',
          'claimedAt'
        ]);
      }

      function hasOwnerId() {
        return request.resource.data.ownerId is string
          && request.resource.data.ownerId.size() >= 8
          && request.resource.data.ownerId.size() <= 128;
      }

      function hasSource() {
        return request.resource.data.source is string
          && request.resource.data.source.size() >= 1
          && request.resource.data.source.size() <= 32;
      }

      function hasTimestampFields() {
        return request.resource.data.timestamp is string
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }

      function isAuthCreate() {
        return signedIn()
          && request.resource.data.viewerId == request.auth.uid
          && !('anonymousSessionId' in request.resource.data);
      }

      function isAnonCreate() {
        return !signedIn()
          && !('viewerId' in request.resource.data)
          && request.resource.data.anonymousSessionId is string
          && request.resource.data.anonymousSessionId.size() >= 8
          && request.resource.data.anonymousSessionId.size() <= 128
          && !('privateNote' in request.resource.data);
      }

      function isViewer() {
        return signedIn()
          && resource.data.viewerId is string
          && resource.data.viewerId == request.auth.uid;
      }

      function isClaimUpdate() {
        return signedIn()
          && resource.data.anonymousSessionId is string
          && !('viewerId' in resource.data)
          && request.resource.data.viewerId == request.auth.uid
          && request.resource.data.anonymousSessionId == resource.data.anonymousSessionId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.source == resource.data.source
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.timestamp == resource.data.timestamp
          && request.resource.data.claimedAt is string
          && request.resource.data.updatedAt is string
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'source', 'createdAt', 'timestamp', 'anonymousSessionId']);
      }

      function isViewerMetadataUpdate() {
        return isViewer()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.viewerId == resource.data.viewerId
          && request.resource.data.source == resource.data.source
          && request.resource.data.createdAt == resource.data.createdAt
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'viewerId', 'source', 'createdAt', 'anonymousSessionId']);
      }

      allow create: if encounterKeysOk()
        && hasOwnerId()
        && hasSource()
        && hasTimestampFields()
        && (isAuthCreate() || isAnonCreate());

      // Scanner + admin only (protects privateNote; owner UI deferred)
      allow read: if isViewer() || isAdmin();

      allow update: if encounterKeysOk()
        && (isClaimUpdate() || isViewerMetadataUpdate());

      allow delete: if isViewer() || isAdmin();
    }
  }
}
